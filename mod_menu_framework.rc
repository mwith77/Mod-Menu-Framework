#include <winver.h>

/* The resources of the Mod Menu Framework: its version and its default
   settings. Bump the version here when the framework is released. */

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "mwith77"
            VALUE "FileDescription",  "Mod Menu Framework"
            VALUE "FileVersion",      "v1.2.0"
            VALUE "InternalName",     "mod_menu_framework"
            VALUE "LegalCopyright",   "mwith77"
            VALUE "OriginalFilename", "mod_menu_framework.dll"
            VALUE "ProductName",      "Mod Menu Framework"
            VALUE "ProductVersion",   "v1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/* The default settings: mod_menu_framework.ini byte for byte, which
   writeDefaultSettings in mod_menu_framework.cpp writes to the mod's folder. */
DEFAULT_SETTINGS RCDATA "mod_menu_framework.ini"
